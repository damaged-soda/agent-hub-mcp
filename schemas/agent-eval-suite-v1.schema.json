{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/agent-eval-suite-v1.schema.json",
  "title": "Agent Hub repository evaluation suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "suite_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "answer_schema"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "prompt": { "type": "string", "minLength": 1 },
          "answer_schema": { "const": "source-location/v1" }
        }
      }
    }
  }
}
