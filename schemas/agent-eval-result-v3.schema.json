{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/agent-eval-result-v3.schema.json",
  "title": "Agent Hub repository patch evaluation result v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "eval_run_id",
    "status",
    "suite",
    "subject",
    "agent",
    "toolchain",
    "isolation",
    "grader_version",
    "cases",
    "summary",
    "created_at",
    "completed_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "kind": { "const": "agent-eval-run" },
    "eval_run_id": { "type": "string", "format": "uuid" },
    "status": { "const": "completed" },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "suite_digest", "relative_path", "case_count"],
      "properties": {
        "suite_id": { "type": "string" },
        "suite_digest": { "$ref": "#/$defs/digest" },
        "relative_path": { "type": "string" },
        "case_count": { "type": "integer", "minimum": 1 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd", "commit", "workspace_digest"],
      "properties": {
        "cwd": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "workspace_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "version", "model", "effort"],
      "properties": {
        "agent_id": { "const": "codex" },
        "version": { "type": "string" },
        "model": { "type": "string" },
        "effort": { "type": ["string", "null"] }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runtime_id",
        "python_version",
        "content_digest",
        "platform",
        "arch"
      ],
      "properties": {
        "kind": { "const": "python-runtime-capsule/v1" },
        "runtime_id": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "minLength": 1 },
        "content_digest": { "$ref": "#/$defs/prefixedDigest" },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "enforcement",
        "data_read",
        "data_write",
        "git_history",
        "tool_network",
        "memory",
        "session_persistence",
        "subagents"
      ],
      "properties": {
        "policy": { "const": "workspace-write/v1" },
        "enforcement": { "const": "codex-permission-profile" },
        "data_read": { "type": "array", "items": { "type": "string" } },
        "data_write": { "type": "array", "items": { "type": "string" } },
        "git_history": { "const": false },
        "tool_network": { "const": false },
        "memory": { "const": "off" },
        "session_persistence": { "const": false },
        "subagents": { "const": false }
      }
    },
    "grader_version": { "const": "workspace-patch/v1" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pass", "fail", "invalid", "error", "not_run"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "pass": { "$ref": "#/$defs/count" },
        "fail": { "$ref": "#/$defs/count" },
        "invalid": { "$ref": "#/$defs/count" },
        "error": { "$ref": "#/$defs/count" },
        "not_run": { "$ref": "#/$defs/count" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prefixedDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "question_digest",
        "answer_digest",
        "agent_run_ref",
        "status",
        "reason",
        "metrics"
      ],
      "properties": {
        "case_id": { "type": "string" },
        "question_digest": { "$ref": "#/$defs/digest" },
        "answer_digest": { "$ref": "#/$defs/digest" },
        "agent_run_ref": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id"],
              "properties": { "run_id": { "type": "string" } }
            },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["pass", "fail", "invalid", "error"] },
        "reason": { "type": "string" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["telemetry_status"],
          "properties": {
            "telemetry_status": {
              "enum": ["available", "missing-events", "projection-error", "not-run"]
            },
            "turns": { "$ref": "#/$defs/count" },
            "tool_calls": { "$ref": "#/$defs/count" },
            "observed_file_reads": { "$ref": "#/$defs/count" },
            "observed_unique_files": { "$ref": "#/$defs/count" },
            "observed_file_writes": { "$ref": "#/$defs/count" },
            "observed_unique_written_files": { "$ref": "#/$defs/count" },
            "elapsed_ms": { "type": "number", "minimum": 0 },
            "usage": { "$ref": "#/$defs/usage" },
            "canonical_usage": { "$ref": "#/$defs/usage" },
            "patch": { "$ref": "#/$defs/patch" },
            "verifier": { "$ref": "#/$defs/verifier" }
          }
        }
      }
    },
    "patch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "changed_files",
            "added_files",
            "modified_files",
            "deleted_files",
            "renamed_files",
            "untracked_files",
            "diff_additions",
            "diff_deletions",
            "binary_files",
            "patch_digest"
          ],
          "properties": {
            "status": { "const": "available" },
            "changed_files": { "$ref": "#/$defs/count" },
            "added_files": { "$ref": "#/$defs/count" },
            "modified_files": { "$ref": "#/$defs/count" },
            "deleted_files": { "$ref": "#/$defs/count" },
            "renamed_files": { "$ref": "#/$defs/count" },
            "untracked_files": { "$ref": "#/$defs/count" },
            "diff_additions": { "$ref": "#/$defs/count" },
            "diff_deletions": { "$ref": "#/$defs/count" },
            "binary_files": { "$ref": "#/$defs/count" },
            "patch_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exit_code", "elapsed_ms"],
      "properties": {
        "status": { "enum": ["passed", "failed", "error"] },
        "exit_code": { "type": ["integer", "null"] },
        "elapsed_ms": { "type": "number", "minimum": 0 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "string", "null"]
      }
    }
  }
}
