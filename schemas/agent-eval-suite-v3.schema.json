{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/agent-eval-suite-v3.schema.json",
  "title": "Agent Hub capability-bound repository patch evaluation suite v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "verifier_preflight",
    "toolchain_requirements",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "suite_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "verifier_preflight": { "const": "subject-reject-known-good-pass/v2" },
    "toolchain_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "commands"],
      "properties": {
        "kind": { "const": "command-smoke/v1" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "argv"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "argv": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                }
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "answer_schema"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "prompt": { "type": "string", "minLength": 1 },
          "answer_schema": { "const": "workspace-patch/v1" }
        }
      }
    }
  }
}
