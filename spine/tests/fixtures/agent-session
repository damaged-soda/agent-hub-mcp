#!/usr/bin/env python3
"""合成 agent-session：按真实 wrapper 的调用形态起 HTTP 并落档案。"""
import json
import os
import signal
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

argv = sys.argv[1:]
assert argv[0] == "serve", argv
options = dict(zip(argv[1::2], argv[2::2]))
record = {"argv": argv, "home": os.environ.get("HOME"),
          "path": os.environ.get("PATH", "")}
# 档案落在 stub 自己旁边：HOME 已被 wrapper 还原成宿主家目录，不往那儿写
Path(__file__).resolve().with_name("record.json").write_text(json.dumps(record))


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_):
        pass

    def do_GET(self):
        base = options["--base-path"]
        if self.path == base + "/healthz":
            status, body = 200, b'{"status":"ok"}'
        else:
            status, body = 404, b"nope"
        self.send_response(status)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


server = ThreadingHTTPServer((options["--host"], int(options["--port"])), Handler)
stop = threading.Event()
for kind in (signal.SIGTERM, signal.SIGINT):
    signal.signal(kind, lambda *_: stop.set())
threading.Thread(target=server.serve_forever, daemon=True).start()
stop.wait()
